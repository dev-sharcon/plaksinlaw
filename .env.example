# Copy to .env.local for local development, and set the same keys in
# Vercel → Project → Settings → Environment Variables.

# Canonical site URL (used for Stripe success/cancel redirects)
NEXT_PUBLIC_SITE_URL=https://plaksinlaw.com

# --- Lead delivery (configure at least one channel, otherwise forms fail in production) ---
# Telegram: create a bot with @BotFather, add it to the chat, get the chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email via Resend (https://resend.com); LEAD_EMAIL_FROM must be on a domain verified in Resend
RESEND_API_KEY=
LEAD_EMAIL_TO=info@plaksinlaw.com
LEAD_EMAIL_FROM=Plaksin Law Website <noreply@plaksinlaw.com>

# --- Cloudflare Turnstile (anti-spam). Leave both empty to disable. ---
# The hostname (plaksinlaw.com and the *.vercel.app preview domain) must be allowed for the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Stripe card payments (secret key, sk_live_... or sk_test_...). Empty = card payments disabled. ---
STRIPE_SECRET_KEY=

# --- Analytics (empty = disabled). Values used on the old site: GTM-5JZ2VBS / 30256339 ---
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_YANDEX_METRIKA_ID=
